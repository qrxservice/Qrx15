# QRX — Production Environment Variables Example
# Copy to artifacts/api-server/.env.production and fill in real values.
# NEVER commit .env.production to git.
#
# Full documentation: ENVIRONMENT_VARIABLES.md

# ─── Required ────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080

# PostgreSQL connection string
DATABASE_URL=postgresql://qrx:CHANGE_ME@localhost:5432/qrx_production

# Session signing secret — generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Canonical public URL of the deployed app (no trailing slash)
APP_URL=https://your-domain.com

# ─── Recommended ─────────────────────────────────────────────────────────────

# Absolute path for uploaded files — keep outside the repo directory
UPLOAD_DIR=/var/www/qrx/uploads

# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── Currency & Language ─────────────────────────────────────────────────────

# auto = detect from visitor IP; or set a fixed value (bn / en)
DEFAULT_LANGUAGE=auto

# auto = detect from visitor IP; or a 2-letter ISO country code (BD / US)
DEFAULT_COUNTRY=auto

# auto = detect from IP; BDT = force Taka; USD = force Dollar
CURRENCY_MODE=auto

BDT_CURRENCY=BDT
USD_CURRENCY=USD

# ─── Payment — SSLCommerz (Bangladesh) ───────────────────────────────────────

SSL_COMMERZ_STORE_ID=
SSL_COMMERZ_STORE_PASSWORD=
SSL_COMMERZ_SANDBOX=false

# ─── Payment — Bangla QR ─────────────────────────────────────────────────────

BANGLA_QR_ENABLED=true

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Can also be configured from Admin UI → Settings → Email after first boot.

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=QRX Platform

# ─── Optional ────────────────────────────────────────────────────────────────

GOOGLE_MAPS_API_KEY=
